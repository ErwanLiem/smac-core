generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model article {
  id               Int                @id @default(autoincrement())
  siteId           Int
  statutId         Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  site             site               @relation(fields: [siteId], references: [id], map: "Article_siteId_fkey")
  statut           statut?            @relation(fields: [statutId], references: [id], map: "Article_statutId_fkey")
  historiquestatut historiquestatut[]
  valeurs          valeurChamp[]
  inventaires      inventaire[]

  @@index([siteId], map: "Article_siteId_fkey")
  @@index([statutId], map: "Article_statutId_fkey")
}

model champArticle {
  id          Int           @id @default(autoincrement())
  siteId      Int
  code        String
  label       String
  type        String        @default("TEXT") // TEXT, NUMBER, DATE, SELECT
  options     String?       @db.LongText     // JSON array pour les SELECT
  obligatoire Boolean       @default(false)
  ordre       Int           @default(0)
  actif       Boolean       @default(true)
  site        site          @relation(fields: [siteId], references: [id], map: "ChampArticle_siteId_fkey")
  valeurs     valeurChamp[]

  @@unique([siteId, code], map: "ChampArticle_siteId_code_key")
  @@index([siteId], map: "ChampArticle_siteId_fkey")
}

model valeurChamp {
  id        Int          @id @default(autoincrement())
  articleId Int
  champId   Int
  valeur    String?      @db.LongText
  article   article      @relation(fields: [articleId], references: [id], map: "ValeurChamp_articleId_fkey")
  champ     champArticle @relation(fields: [champId], references: [id], map: "ValeurChamp_champId_fkey")

  @@unique([articleId, champId], map: "ValeurChamp_articleId_champId_key")
  @@index([articleId], map: "ValeurChamp_articleId_fkey")
  @@index([champId], map: "ValeurChamp_champId_fkey")
}

model client {
  id        Int                @id @default(autoincrement())
  siteId    Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  site      site               @relation(fields: [siteId], references: [id], map: "Client_siteId_fkey")
  valeurs   valeurChampClient[]

  @@index([siteId], map: "Client_siteId_fkey")
}

model champClient {
  id          Int                @id @default(autoincrement())
  siteId      Int
  code        String
  label       String
  type        String             @default("TEXT")
  options     String?            @db.LongText
  obligatoire Boolean            @default(false)
  ordre       Int                @default(0)
  actif       Boolean            @default(true)
  site        site               @relation(fields: [siteId], references: [id], map: "ChampClient_siteId_fkey")
  valeurs     valeurChampClient[]

  @@unique([siteId, code], map: "ChampClient_siteId_code_key")
  @@index([siteId], map: "ChampClient_siteId_fkey")
}

model valeurChampClient {
  id       Int         @id @default(autoincrement())
  clientId Int
  champId  Int
  valeur   String?     @db.LongText
  client   client      @relation(fields: [clientId], references: [id], map: "ValeurChampClient_clientId_fkey")
  champ    champClient @relation(fields: [champId], references: [id], map: "ValeurChampClient_champId_fkey")

  @@unique([clientId, champId], map: "ValeurChampClient_clientId_champId_key")
  @@index([clientId], map: "ValeurChampClient_clientId_fkey")
  @@index([champId], map: "ValeurChampClient_champId_fkey")
}

model plateforme {
  id        Int                     @id @default(autoincrement())
  siteId    Int
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  site      site                    @relation(fields: [siteId], references: [id], map: "Plateforme_siteId_fkey")
  valeurs   valeurChampPlateforme[]

  @@index([siteId], map: "Plateforme_siteId_fkey")
}

model champPlateforme {
  id          Int                     @id @default(autoincrement())
  siteId      Int
  code        String
  label       String
  type        String                  @default("TEXT")
  options     String?                 @db.LongText
  obligatoire Boolean                 @default(false)
  ordre       Int                     @default(0)
  actif       Boolean                 @default(true)
  site        site                    @relation(fields: [siteId], references: [id], map: "ChampPlateforme_siteId_fkey")
  valeurs     valeurChampPlateforme[]

  @@unique([siteId, code], map: "ChampPlateforme_siteId_code_key")
  @@index([siteId], map: "ChampPlateforme_siteId_fkey")
}

model valeurChampPlateforme {
  id           Int             @id @default(autoincrement())
  plateformeId Int
  champId      Int
  valeur       String?         @db.LongText
  plateforme   plateforme      @relation(fields: [plateformeId], references: [id], map: "ValeurChampPlateforme_plateformeId_fkey")
  champ        champPlateforme @relation(fields: [champId], references: [id], map: "ValeurChampPlateforme_champId_fkey")

  @@unique([plateformeId, champId], map: "ValeurChampPlateforme_plateformeId_champId_key")
  @@index([plateformeId], map: "ValeurChampPlateforme_plateformeId_fkey")
  @@index([champId], map: "ValeurChampPlateforme_champId_fkey")
}

model inventaire {
  id               Int                @id @default(autoincrement())
  siteId           Int
  articleId        Int?
  statutId         Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  site             site               @relation(fields: [siteId], references: [id], map: "Inventaire_siteId_fkey")
  article          article?           @relation(fields: [articleId], references: [id], map: "Inventaire_articleId_fkey")
  statut           statut?            @relation(fields: [statutId], references: [id], onDelete: Cascade, map: "Inventaire_statutId_fkey")
  valeurs          valeurChampInventaire[]

  @@index([siteId], map: "Inventaire_siteId_fkey")
  @@index([articleId], map: "Inventaire_articleId_fkey")
  @@index([statutId], map: "Inventaire_statutId_fkey")
}

model champInventaire {
  id                 Int                     @id @default(autoincrement())
  siteId             Int
  code               String
  label              String
  type               String                  @default("TEXT") // TEXT, NUMBER, DATE, SELECT
  options            String?                 @db.LongText     // JSON array pour les SELECT
  obligatoire        Boolean                 @default(false)
  ordre              Int                     @default(0)
  actif              Boolean                 @default(true)
  visibleReceptionSN      Boolean             @default(false)
  visibleReceptionQTE     Boolean             @default(false)
  site               site                    @relation(fields: [siteId], references: [id], map: "ChampInventaire_siteId_fkey")
  valeurs            valeurChampInventaire[]

  @@unique([siteId, code], map: "ChampInventaire_siteId_code_key")
  @@index([siteId], map: "ChampInventaire_siteId_fkey")
}

model valeurChampInventaire {
  id          Int              @id @default(autoincrement())
  inventaireId Int
  champId     Int
  valeur      String?          @db.LongText
  inventaire  inventaire       @relation(fields: [inventaireId], references: [id], onDelete: Cascade, map: "ValeurChampInventaire_inventaireId_fkey")
  champ       champInventaire  @relation(fields: [champId], references: [id], map: "ValeurChampInventaire_champId_fkey")

  @@unique([inventaireId, champId], map: "ValeurChampInventaire_inventaireId_champId_key")
  @@index([inventaireId], map: "ValeurChampInventaire_inventaireId_fkey")
  @@index([champId], map: "ValeurChampInventaire_champId_fkey")
}

// Module Attendus (réception sur fichier client)
model attendu {
  id          Int            @id @default(autoincrement())
  siteId      Int
  rma               String?
  bt                String?
  client            String?
  plateforme        String?
  dateCreationRMA   String?
  statut      String         @default("EN_COURS") // EN_COURS, CLOS
  createdAt   DateTime       @default(now())
  closedAt    DateTime?
  site        site           @relation(fields: [siteId], references: [id], map: "Attendu_siteId_fkey")
  lignes      ligneAttendue[]

  @@index([siteId], map: "Attendu_siteId_fkey")
}

model ligneAttendue {
  id           Int      @id @default(autoincrement())
  attenduId    Int
  pn           String
  sn           String
  panneClient  String?
  garantie     String?
  statut       String   @default("ATTENDU") // ATTENDU, RECU, NON_RECU, INATTENDU, DOUBLON_INVENTAIRE
  snRecu       String?  // SN réellement scanné si différent
  accessoires  String?  @db.LongText // JSON array des accessoires reçus
  notes        String?  // Info complémentaire (ex: RMA existant pour DOUBLON_INVENTAIRE)
  createdAt    DateTime @default(now())
  attendu      attendu  @relation(fields: [attenduId], references: [id], onDelete: Cascade, map: "LigneAttendue_attenduId_fkey")

  @@index([attenduId], map: "LigneAttendue_attenduId_fkey")
}

// Configuration du mapping colonnes Excel → champs inventaire
model configImportExcel {
  id                  Int    @id @default(autoincrement())
  siteId              Int
  colonneExcel        String // nom exact de la colonne dans le fichier Excel
  champInventaireCode String // code du champ inventaire cible
  actif               Boolean @default(true)
  site                site   @relation(fields: [siteId], references: [id], map: "ConfigImportExcel_siteId_fkey")

  @@unique([siteId, colonneExcel], map: "ConfigImportExcel_siteId_colonneExcel_key")
  @@index([siteId], map: "ConfigImportExcel_siteId_fkey")
}

model historiqueActivite {
  id         Int      @id @default(autoincrement())
  siteId     Int
  userId     Int?
  type       String   // RECEPTION, MODIFICATION, SUPPRESSION, TRANSITION_STATUT, etc.
  entite     String   // inventaire, article, client, plateforme, etc.
  entiteId   Int?
  details    String?  @db.LongText // JSON avec les détails du mouvement
  createdAt  DateTime @default(now())
  site       site     @relation(fields: [siteId], references: [id], map: "HistoriqueActivite_siteId_fkey")

  @@index([siteId], map: "HistoriqueActivite_siteId_fkey")
  @@index([type], map: "HistoriqueActivite_type_fkey")
  @@index([entite, entiteId], map: "HistoriqueActivite_entite_fkey")
}

model historiquestatut {
  id          Int      @id @default(autoincrement())
  articleId   Int
  statutId    Int
  commentaire String?
  userId      Int?
  createdAt   DateTime @default(now())
  article     article  @relation(fields: [articleId], references: [id], map: "HistoriqueStatut_articleId_fkey")
  statut      statut   @relation(fields: [statutId], references: [id], map: "HistoriqueStatut_statutId_fkey")

  @@index([articleId], map: "HistoriqueStatut_articleId_fkey")
  @@index([statutId], map: "HistoriqueStatut_statutId_fkey")
}

model role {
  id              Int               @id @default(autoincrement())
  siteId          Int
  code            String
  label           String
  site            site              @relation(fields: [siteId], references: [id], map: "Role_siteId_fkey")
  utilisateur     utilisateur[]
  permissions     permissionRole[]

  @@unique([siteId, code], map: "Role_siteId_code_key")
}

model site {
  id          Int           @id @default(autoincrement())
  nom         String
  slug        String        @unique(map: "Site_slug_key")
  actif       Boolean       @default(true)
  createdAt   DateTime      @default(now())
  article              article[]
  role                 role[]
  statut               statut[]
  transition           transition[]
  utilisateur          utilisateur[]
  champArticle         champArticle[]
  client               client[]
  champClient          champClient[]
  plateforme           plateforme[]
  champPlateforme      champPlateforme[]
  inventaire           inventaire[]
  champInventaire      champInventaire[]
  historiqueActivite   historiqueActivite[]
  attendu              attendu[]
  configImportExcel    configImportExcel[]
}

model statut {
  id                                         Int                @id @default(autoincrement())
  siteId                                     Int
  code                                       String
  label                                      String
  couleur                                    String             @default("#6b7280")
  icone                                      String?
  ordre                                      Int                @default(0)
  estFinal                                   Boolean            @default(false)
  article                                    article[]
  inventaire                                 inventaire[]
  historiquestatut                           historiquestatut[]
  site                                       site               @relation(fields: [siteId], references: [id], map: "Statut_siteId_fkey")
  transitionsFrom transition[] @relation("transition_statutFromIdTostatut")
  transitionsTo   transition[] @relation("transition_statutToIdTostatut")

  @@unique([siteId, code], map: "Statut_siteId_code_key")
}

model transition {
  id                                     Int    @id @default(autoincrement())
  siteId                                 Int
  statutFromId                           Int
  statutToId                             Int
  labelBouton                            String
  couleurBouton                          String @default("#3b82f6")
  ordre                                  Int    @default(0)
  site                                   site   @relation(fields: [siteId], references: [id], map: "Transition_siteId_fkey")
  statutFrom statut @relation("transition_statutFromIdTostatut", fields: [statutFromId], references: [id], onDelete: Cascade, map: "Transition_statutFromId_fkey")
  statutTo   statut @relation("transition_statutToIdTostatut", fields: [statutToId], references: [id], onDelete: Cascade, map: "Transition_statutToId_fkey")

  @@index([siteId], map: "Transition_siteId_fkey")
  @@index([statutFromId], map: "Transition_statutFromId_fkey")
  @@index([statutToId], map: "Transition_statutToId_fkey")
}

model utilisateur {
  id               Int      @id @default(autoincrement())
  siteId           Int
  nom              String
  prenom           String
  login            String   @unique(map: "Utilisateur_login_key")
  motDePasse       String
  roleId           Int
  actif            Boolean  @default(true)
  doitChangerMdp   Boolean  @default(true)
  createdAt        DateTime @default(now())
  role             role     @relation(fields: [roleId], references: [id], map: "Utilisateur_roleId_fkey")
  site             site     @relation(fields: [siteId], references: [id], map: "Utilisateur_siteId_fkey")

  @@index([roleId], map: "Utilisateur_roleId_fkey")
  @@index([siteId], map: "Utilisateur_siteId_fkey")
}

model permissionRole {
  id     Int    @id @default(autoincrement())
  roleId Int
  page   String
  action String @default("view")
  role   role   @relation(fields: [roleId], references: [id], map: "PermissionRole_roleId_fkey")

  @@unique([roleId, page, action], map: "PermissionRole_roleId_page_action_key")
  @@index([roleId], map: "PermissionRole_roleId_fkey")
}
