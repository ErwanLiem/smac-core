generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model article {
  id               Int                @id @default(autoincrement())
  siteId           Int
  statutId         Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  site             site               @relation(fields: [siteId], references: [id], map: "Article_siteId_fkey")
  statut           statut?            @relation(fields: [statutId], references: [id], map: "Article_statutId_fkey")
  historiqueStatuts historiqueStatut[]
  valeurs           valeurChamp[]
  inventaires       inventaire[]
  demandesTransfert demandeTransfert[]
  inventairesLabo   inventaireLabo[]

  @@index([siteId], map: "Article_siteId_fkey")
  @@index([statutId], map: "Article_statutId_fkey")
}

model champArticle {
  id          Int           @id @default(autoincrement())
  siteId      Int
  code        String
  label       String
  type        String        @default("TEXT")
  options     String?       @db.LongText
  obligatoire Boolean       @default(false)
  ordre       Int           @default(0)
  actif       Boolean       @default(true)
  site        site          @relation(fields: [siteId], references: [id], map: "ChampArticle_siteId_fkey")
  valeurs     valeurChamp[]

  @@unique([siteId, code], map: "ChampArticle_siteId_code_key")
  @@index([siteId], map: "ChampArticle_siteId_fkey")
}

model valeurChamp {
  id        Int          @id @default(autoincrement())
  articleId Int
  champId   Int
  valeur    String?      @db.LongText
  article   article      @relation(fields: [articleId], references: [id], map: "ValeurChamp_articleId_fkey")
  champ     champArticle @relation(fields: [champId], references: [id], map: "ValeurChamp_champId_fkey")

  @@unique([articleId, champId], map: "ValeurChamp_articleId_champId_key")
  @@index([articleId], map: "ValeurChamp_articleId_fkey")
  @@index([champId], map: "ValeurChamp_champId_fkey")
}

model client {
  id        Int                @id @default(autoincrement())
  siteId    Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  site      site               @relation(fields: [siteId], references: [id], map: "Client_siteId_fkey")
  valeurs   valeurChampClient[]

  @@index([siteId], map: "Client_siteId_fkey")
}

model champClient {
  id          Int                @id @default(autoincrement())
  siteId      Int
  code        String
  label       String
  type        String             @default("TEXT")
  options     String?            @db.LongText
  obligatoire Boolean            @default(false)
  ordre       Int                @default(0)
  actif       Boolean            @default(true)
  site        site               @relation(fields: [siteId], references: [id], map: "ChampClient_siteId_fkey")
  valeurs     valeurChampClient[]

  @@unique([siteId, code], map: "ChampClient_siteId_code_key")
  @@index([siteId], map: "ChampClient_siteId_fkey")
}

model valeurChampClient {
  id       Int         @id @default(autoincrement())
  clientId Int
  champId  Int
  valeur   String?     @db.LongText
  client   client      @relation(fields: [clientId], references: [id], map: "ValeurChampClient_clientId_fkey")
  champ    champClient @relation(fields: [champId], references: [id], map: "ValeurChampClient_champId_fkey")

  @@unique([clientId, champId], map: "ValeurChampClient_clientId_champId_key")
  @@index([clientId], map: "ValeurChampClient_clientId_fkey")
  @@index([champId], map: "ValeurChampClient_champId_fkey")
}

model plateforme {
  id        Int                     @id @default(autoincrement())
  siteId    Int
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  site      site                    @relation(fields: [siteId], references: [id], map: "Plateforme_siteId_fkey")
  valeurs   valeurChampPlateforme[]

  @@index([siteId], map: "Plateforme_siteId_fkey")
}

model champPlateforme {
  id          Int                     @id @default(autoincrement())
  siteId      Int
  code        String
  label       String
  type        String                  @default("TEXT")
  options     String?                 @db.LongText
  obligatoire Boolean                 @default(false)
  ordre       Int                     @default(0)
  actif       Boolean                 @default(true)
  site        site                    @relation(fields: [siteId], references: [id], map: "ChampPlateforme_siteId_fkey")
  valeurs     valeurChampPlateforme[]

  @@unique([siteId, code], map: "ChampPlateforme_siteId_code_key")
  @@index([siteId], map: "ChampPlateforme_siteId_fkey")
}

model valeurChampPlateforme {
  id           Int             @id @default(autoincrement())
  plateformeId Int
  champId      Int
  valeur       String?         @db.LongText
  plateforme   plateforme      @relation(fields: [plateformeId], references: [id], map: "ValeurChampPlateforme_plateformeId_fkey")
  champ        champPlateforme @relation(fields: [champId], references: [id], map: "ValeurChampPlateforme_champId_fkey")

  @@unique([plateformeId, champId], map: "ValeurChampPlateforme_plateformeId_champId_key")
  @@index([plateformeId], map: "ValeurChampPlateforme_plateformeId_fkey")
  @@index([champId], map: "ValeurChampPlateforme_champId_fkey")
}

// ─── Inventaire ───────────────────────────────────────────────────────────────

model inventaire {
  id                 Int       @id @default(autoincrement())
  siteId             Int
  articleId          Int?
  statutId           Int?

  // Identification
  serialNumber       String?
  partNumber         String?
  rma                String?
  customer           String?
  productFamily      String?
  mercurySn          String?
  warranty           String?
  rmaCreationDate    DateTime? @db.Date

  // Réception
  dateRic            DateTime? @db.Date
  defectFromCustomer String?
  descrCode          String?
  repaireNotes       String?
  genericNotes       String?

  // Réparation
  dateRip            DateTime? @db.Date
  techLabo           String?
  livelloRiparazione String?
  dateLav            DateTime? @db.Date
  dateAsp            DateTime? @db.Date
  dateLab            DateTime? @db.Date
  datePrv            DateTime? @db.Date
  datePrr            DateTime? @db.Date
  datePrf            DateTime? @db.Date
  datePra            DateTime? @db.Date
  dateEng            DateTime? @db.Date
  dateAsw            DateTime? @db.Date
  dateBsf            DateTime? @db.Date
  dateBsfn           DateTime? @db.Date
  dateNlv            DateTime? @db.Date

  // MAJ / Injection
  dateMaj            DateTime? @db.Date

  // Contrôle qualité
  dateTest           DateTime? @db.Date

  // Logistique sortante
  datePack           DateTime? @db.Date
  dateCls            DateTime? @db.Date
  dateSHP            DateTime? @db.Date

  // Méta
  archive            Boolean   @default(false)
  couleurAlerte      String?
  regleAlerteId      Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  site               site                    @relation(fields: [siteId], references: [id], map: "Inventaire_siteId_fkey")
  article            article?                @relation(fields: [articleId], references: [id], map: "Inventaire_articleId_fkey")
  statut             statut?                 @relation(fields: [statutId], references: [id], onDelete: Cascade, map: "Inventaire_statutId_fkey")
  regleAlerte        regleAlerte?            @relation(fields: [regleAlerteId], references: [id], map: "Inventaire_regleAlerteId_fkey")
  pieces             piecesUtilisees[]
  lignesTransfert    ligneDemandeTransfert[]
  ligneMasterBox     ligneMasterBox?

  @@index([siteId], map: "Inventaire_siteId_fkey")
  @@index([articleId], map: "Inventaire_articleId_fkey")
  @@index([statutId], map: "Inventaire_statutId_fkey")
  @@index([regleAlerteId], map: "Inventaire_regleAlerteId_fkey")
  @@index([siteId, archive])
  @@index([serialNumber])
  @@index([rma])
}

model piecesUtilisees {
  id           Int        @id @default(autoincrement())
  inventaireId Int
  pn           String?
  pnType       String?
  sp           String?
  status       String?
  createdAt    DateTime   @default(now())
  inventaire   inventaire @relation(fields: [inventaireId], references: [id], onDelete: Cascade, map: "PiecesUtilisees_inventaireId_fkey")

  @@index([inventaireId], map: "PiecesUtilisees_inventaireId_fkey")
}

// ─── Module Attendus ──────────────────────────────────────────────────────────

model attendu {
  id              Int             @id @default(autoincrement())
  siteId          Int
  rma             String?
  bt              String?
  donneesCommunes String?         @db.LongText // JSON {colonne: valeur} pour les champs communs saisis à la création
  statut          String          @default("EN_COURS") // EN_COURS, CLOS
  createdAt       DateTime        @default(now())
  closedAt        DateTime?
  site            site            @relation(fields: [siteId], references: [id], map: "Attendu_siteId_fkey")
  lignes          ligneAttendue[]

  @@index([siteId], map: "Attendu_siteId_fkey")
}

model ligneAttendue {
  id           Int      @id @default(autoincrement())
  attenduId    Int
  pn           String
  sn           String
  panneClient  String?
  garantie     String?
  statut       String   @default("ATTENDU") // ATTENDU, RECU, NON_RECU, INATTENDU, DOUBLON_INVENTAIRE
  snRecu       String?
  accessoires  String?  @db.LongText
  notes        String?
  caisse       String?
  createdAt    DateTime @default(now())
  attendu      attendu  @relation(fields: [attenduId], references: [id], onDelete: Cascade, map: "LigneAttendue_attenduId_fkey")

  @@index([attenduId], map: "LigneAttendue_attenduId_fkey")
}

model configAttendus {
  id                     Int     @id @default(autoincrement())
  siteId                 Int     @unique
  nomOnglet              String  @default("Terminal Details")
  obligatoirePNcatalogue Boolean @default(true)
  statutCloture          String?
  champsAttendu          String? @db.LongText
  site                   site    @relation(fields: [siteId], references: [id], map: "ConfigAttendus_siteId_fkey")
}

// Mapping colonnes Excel → colonnes inventaire fixes
model configImportExcel {
  id               Int     @id @default(autoincrement())
  siteId           Int
  colonneExcel     String
  colonneInventaire String  // nom de la colonne fixe dans inventaire (ex: serialNumber, rma, partNumber)
  roleSpecial      String? // SN | PN | null
  actif            Boolean @default(true)
  site             site    @relation(fields: [siteId], references: [id], map: "ConfigImportExcel_siteId_fkey")

  @@unique([siteId, colonneExcel], map: "ConfigImportExcel_siteId_colonneExcel_key")
  @@index([siteId], map: "ConfigImportExcel_siteId_fkey")
}

// ─── Historique ───────────────────────────────────────────────────────────────

model historiqueActivite {
  id        Int      @id @default(autoincrement())
  siteId    Int
  userId    Int?
  type      String
  entite    String
  entiteId  Int?
  details   String?  @db.LongText
  createdAt DateTime @default(now())
  site      site     @relation(fields: [siteId], references: [id], map: "HistoriqueActivite_siteId_fkey")

  @@index([siteId], map: "HistoriqueActivite_siteId_fkey")
  @@index([type], map: "HistoriqueActivite_type_fkey")
  @@index([entite, entiteId], map: "HistoriqueActivite_entite_fkey")
}

model historiqueStatut {
  id          Int      @id @default(autoincrement())
  articleId   Int
  statutId    Int
  commentaire String?
  userId      Int?
  createdAt   DateTime @default(now())
  article     article  @relation(fields: [articleId], references: [id], map: "HistoriqueStatut_articleId_fkey")
  statut      statut   @relation(fields: [statutId], references: [id], map: "HistoriqueStatut_statutId_fkey")

  @@index([articleId], map: "HistoriqueStatut_articleId_fkey")
  @@index([statutId], map: "HistoriqueStatut_statutId_fkey")
  @@map("HistoriqueStatut")
}

// ─── Accès & Utilisateurs ─────────────────────────────────────────────────────

model role {
  id          Int              @id @default(autoincrement())
  siteId      Int
  code        String
  label       String
  site        site             @relation(fields: [siteId], references: [id], map: "Role_siteId_fkey")
  utilisateur utilisateur[]
  permissions permissionRole[]

  @@unique([siteId, code], map: "Role_siteId_code_key")
}

model utilisateur {
  id               Int      @id @default(autoincrement())
  siteId           Int
  nom              String
  prenom           String
  login            String   @unique(map: "Utilisateur_login_key")
  motDePasse       String
  roleId           Int
  actif            Boolean  @default(true)
  doitChangerMdp   Boolean  @default(true)
  createdAt        DateTime @default(now())
  role                 role                   @relation(fields: [roleId], references: [id], map: "Utilisateur_roleId_fkey")
  site                 site                   @relation(fields: [siteId], references: [id], map: "Utilisateur_siteId_fkey")
  technicienProduction technicienProduction[]

  @@index([roleId], map: "Utilisateur_roleId_fkey")
  @@index([siteId], map: "Utilisateur_siteId_fkey")
}

model permissionRole {
  id     Int    @id @default(autoincrement())
  roleId Int
  page   String
  action String @default("view")
  role   role   @relation(fields: [roleId], references: [id], map: "PermissionRole_roleId_fkey")

  @@unique([roleId, page, action], map: "PermissionRole_roleId_page_action_key")
  @@index([roleId], map: "PermissionRole_roleId_fkey")
}

// ─── Site ─────────────────────────────────────────────────────────────────────

model site {
  id          Int           @id @default(autoincrement())
  nom         String
  slug        String        @unique(map: "Site_slug_key")
  actif       Boolean       @default(true)
  createdAt   DateTime      @default(now())
  article              article[]
  role                 role[]
  statut               statut[]
  transition           transition[]
  utilisateur          utilisateur[]
  champArticle         champArticle[]
  client               client[]
  champClient          champClient[]
  plateforme           plateforme[]
  champPlateforme      champPlateforme[]
  inventaire           inventaire[]
  historiqueActivite   historiqueActivite[]
  attendu              attendu[]
  configAttendus       configAttendus?
  configImportExcel    configImportExcel[]
  regleAlerte          regleAlerte[]
  configSite           configSite?
  compteurBL           compteurBL[]
  brouillonBL          brouillonBL[]
  configProduction     configProduction?
  technicienProduction technicienProduction[]
  demandeTransfert     demandeTransfert[]
  inventaireLabo       inventaireLabo[]
  masterBox            masterBox[]
  exceptionCapaciteJour exceptionCapaciteJour[]
  emplacements          emplacement[]
}

// ─── Workflow ─────────────────────────────────────────────────────────────────

model statut {
  id                Int                @id @default(autoincrement())
  siteId            Int
  code              String
  label             String
  couleur           String             @default("#6b7280")
  icone             String?
  ordre             Int                @default(0)
  roles             String             @default("[]") @db.Text
  article           article[]
  inventaire        inventaire[]
  historiqueStatuts historiqueStatut[]
  site              site               @relation(fields: [siteId], references: [id], map: "Statut_siteId_fkey")
  transitionsFrom   transition[]       @relation("transition_statutFromIdTostatut")
  transitionsTo     transition[]       @relation("transition_statutToIdTostatut")

  @@unique([siteId, code], map: "Statut_siteId_code_key")
}

model transition {
  id            Int    @id @default(autoincrement())
  siteId        Int
  statutFromId  Int
  statutToId    Int
  labelBouton   String
  couleurBouton String @default("#3b82f6")
  ordre         Int    @default(0)
  site          site   @relation(fields: [siteId], references: [id], map: "Transition_siteId_fkey")
  statutFrom    statut @relation("transition_statutFromIdTostatut", fields: [statutFromId], references: [id], onDelete: Cascade, map: "Transition_statutFromId_fkey")
  statutTo      statut @relation("transition_statutToIdTostatut", fields: [statutToId], references: [id], onDelete: Cascade, map: "Transition_statutToId_fkey")

  @@index([siteId], map: "Transition_siteId_fkey")
  @@index([statutFromId], map: "Transition_statutFromId_fkey")
  @@index([statutToId], map: "Transition_statutToId_fkey")
}

// ─── Règles d'alerte ──────────────────────────────────────────────────────────

model regleAlerte {
  id             Int          @id @default(autoincrement())
  siteId         Int
  nom            String
  codeChampDate  String       // nom de la colonne fixe inventaire (ex: dateRic, dateRip, dateTest)
  seuilMois      Int          @default(3)
  couleurAlerte  String       @default("#f59e0b")
  champsAutoFill String?      @db.LongText // JSON: [{ colonne: "genericNotes", valeur: "Sous garantie" }]
  actif          Boolean      @default(true)
  createdAt      DateTime     @default(now())
  site           site         @relation(fields: [siteId], references: [id], map: "RegleAlerte_siteId_fkey")
  inventaires    inventaire[]

  @@index([siteId], map: "RegleAlerte_siteId_fkey")
}

// ─── Module Production ────────────────────────────────────────────────────────

model configProduction {
  id                   Int     @id @default(autoincrement())
  siteId               Int     @unique
  champTypeArticleCode String  @default("TYPE")
  typesArticleQTE      String? @db.LongText
  champsAffichageQTE   String? @db.LongText
  quotaSamediActif     Boolean @default(false)
  site                 site    @relation(fields: [siteId], references: [id], map: "ConfigProduction_siteId_fkey")
}

model technicienProduction {
  id              Int                 @id @default(autoincrement())
  siteId          Int
  userId          Int
  quotaJournalier Int                 @default(10)
  actif           Boolean             @default(true)
  site            site                @relation(fields: [siteId], references: [id], map: "TechnicienProduction_siteId_fkey")
  utilisateur     utilisateur         @relation(fields: [userId], references: [id], map: "TechnicienProduction_userId_fkey")
  absences        absenceTechnicien[]

  @@unique([siteId, userId], map: "TechnicienProduction_siteId_userId_key")
  @@index([siteId], map: "TechnicienProduction_siteId_fkey")
  @@index([userId], map: "TechnicienProduction_userId_fkey")
}

model absenceTechnicien {
  id            Int                  @id @default(autoincrement())
  technicienId  Int
  date          DateTime             @db.Date
  motif         String?
  quotaOverride Int?
  technicien    technicienProduction @relation(fields: [technicienId], references: [id], onDelete: Cascade, map: "AbsenceTechnicien_technicienId_fkey")

  @@unique([technicienId, date], map: "AbsenceTechnicien_technicienId_date_key")
  @@index([technicienId], map: "AbsenceTechnicien_technicienId_fkey")
}

model exceptionCapaciteJour {
  id     Int      @id @default(autoincrement())
  siteId Int
  date   DateTime @db.Date
  actif  Boolean
  site   site     @relation(fields: [siteId], references: [id], map: "ExceptionCapaciteJour_siteId_fkey")

  @@unique([siteId, date], map: "ExceptionCapaciteJour_siteId_date_key")
  @@index([siteId], map: "ExceptionCapaciteJour_siteId_idx")
}

model demandeTransfert {
  id            Int                     @id @default(autoincrement())
  siteId        Int
  type          String
  statut        String                  @default("EN_ATTENTE")
  datePlanifiee DateTime                @db.Date
  quantite      Int
  pnValeur      String?
  rmaValeur     String?
  clientValeur  String?
  articleId     Int?
  createdAt     DateTime                @default(now())
  site          site                    @relation(fields: [siteId], references: [id], map: "DemandeTransfert_siteId_fkey")
  article       article?                @relation(fields: [articleId], references: [id], map: "DemandeTransfert_articleId_fkey")
  lignes        ligneDemandeTransfert[]

  @@index([siteId], map: "DemandeTransfert_siteId_fkey")
  @@index([articleId], map: "DemandeTransfert_articleId_fkey")
}

model ligneDemandeTransfert {
  id                 Int              @id @default(autoincrement())
  demandeTransfertId Int
  inventaireId       Int
  demande            demandeTransfert @relation(fields: [demandeTransfertId], references: [id], onDelete: Cascade, map: "LigneDemandeTransfert_demandeId_fkey")
  inventaire         inventaire       @relation(fields: [inventaireId], references: [id], onDelete: Cascade, map: "LigneDemandeTransfert_inventaireId_fkey")

  @@unique([demandeTransfertId, inventaireId], map: "LigneDemandeTransfert_demandeId_inventaireId_key")
  @@index([demandeTransfertId], map: "LigneDemandeTransfert_demandeId_fkey")
  @@index([inventaireId], map: "LigneDemandeTransfert_inventaireId_fkey")
}

// ─── Expéditions ──────────────────────────────────────────────────────────────

model masterBox {
  id           Int              @id @default(autoincrement())
  siteId       Int
  numero       String
  clientValeur String?
  statut       String           @default("EN_ATTENTE")
  userId       Int?
  createdAt    DateTime         @default(now())
  site         site             @relation(fields: [siteId], references: [id], map: "MasterBox_siteId_fkey")
  lignes       ligneMasterBox[]

  @@index([siteId, clientValeur, numero], map: "MasterBox_siteId_clientValeur_numero_idx")
  @@index([siteId], map: "MasterBox_siteId_fkey")
}

model ligneMasterBox {
  id           Int        @id @default(autoincrement())
  masterBoxId  Int
  inventaireId Int
  masterBox    masterBox  @relation(fields: [masterBoxId], references: [id], onDelete: Cascade, map: "LigneMasterBox_masterBoxId_fkey")
  inventaire   inventaire @relation(fields: [inventaireId], references: [id], onDelete: Cascade, map: "LigneMasterBox_inventaireId_fkey")

  @@unique([inventaireId], map: "LigneMasterBox_inventaireId_key")
  @@index([masterBoxId], map: "LigneMasterBox_masterBoxId_fkey")
  @@index([inventaireId], map: "LigneMasterBox_inventaireId_fkey")
}

// ─── Inventaire labo (PDA) ────────────────────────────────────────────────────

model inventaireLabo {
  id        Int      @id @default(autoincrement())
  siteId    Int
  articleId Int
  quantite  Int      @default(0)
  updatedAt DateTime @updatedAt
  site      site     @relation(fields: [siteId], references: [id], map: "InventaireLabo_siteId_fkey")
  article   article  @relation(fields: [articleId], references: [id], map: "InventaireLabo_articleId_fkey")

  @@unique([siteId, articleId], map: "InventaireLabo_siteId_articleId_key")
  @@index([siteId], map: "InventaireLabo_siteId_fkey")
  @@index([articleId], map: "InventaireLabo_articleId_fkey")
}

// ─── Emplacements ─────────────────────────────────────────────────────────────

model emplacement {
  id          Int      @id @default(autoincrement())
  siteId      Int
  nom         String
  capaciteMax Int
  description String?  @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        site     @relation(fields: [siteId], references: [id], map: "Emplacement_siteId_fkey")

  @@unique([siteId, nom], map: "Emplacement_siteId_nom_key")
  @@index([siteId], map: "Emplacement_siteId_fkey")
}

// ─── Configuration site ───────────────────────────────────────────────────────

model configSite {
  id            Int    @id @default(autoincrement())
  siteId        Int    @unique
  nomSociete    String @default("")
  adresse       String @default("")
  ville         String @default("")
  codePostal    String @default("")
  pays          String @default("")
  tel           String @default("")
  email         String @default("")
  siteWeb       String @default("")
  tva           String @default("")
  capitalSocial String @default("")
  site          site   @relation(fields: [siteId], references: [id], map: "ConfigSite_siteId_fkey")
}

model brouillonBL {
  id           Int      @id @default(autoincrement())
  siteId       Int
  clientValeur String?
  numeroBL     String
  bonTransport String?
  eta          String?
  colisJson    String?  @db.LongText
  plateformeId Int?
  updatedAt    DateTime @updatedAt
  site         site     @relation(fields: [siteId], references: [id], map: "BrouillonBL_siteId_fkey")

  @@unique([siteId, clientValeur], map: "BrouillonBL_siteId_clientValeur_key")
  @@index([siteId], map: "BrouillonBL_siteId_fkey")
}

model compteurBL {
  id      Int    @id @default(autoincrement())
  siteId  Int
  annee   Int
  dernier Int    @default(0)
  site    site   @relation(fields: [siteId], references: [id], map: "CompteurBL_siteId_fkey")

  @@unique([siteId, annee], map: "CompteurBL_siteId_annee_key")
  @@index([siteId], map: "CompteurBL_siteId_fkey")
}
